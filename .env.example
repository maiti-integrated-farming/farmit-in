# FarmIt Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
FLASK_CONFIG=development  # Options: development, testing, staging, production
FLASK_APP=run.py
FLASK_ENV=development

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-minimum-32-characters-long

# =============================================================================
# PRIMARY DATABASE (Neon DB)
# =============================================================================
# For production, use Neon DB serverless PostgreSQL
# Example: postgresql://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/farmit?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@neon-host:5432/farmit

# For development (SQLite is used by default if not set)
# DATABASE_URL=sqlite:///farmit_dev.db

# =============================================================================
# ARCHIVE DATABASE (Supabase)
# =============================================================================
# For historical data storage (1+ years old)
# Example: postgresql://postgres:password@db.projectid.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:password@supabase-host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# =============================================================================
# DATA ARCHIVAL CONFIGURATION
# =============================================================================
DATA_ARCHIVAL_ENABLED=true  # Set to false to disable automatic archival
ARCHIVAL_AGE_YEARS=1  # Archive data older than this many years
ARCHIVAL_COMPRESSION=gzip  # Compression type: gzip, lz4, zstd

# =============================================================================
# REDIS (Caching & Sessions)
# =============================================================================
# For production, use managed Redis (AWS ElastiCache, Redis Cloud, etc.)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CELERY (Background Jobs)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# For Gmail:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@farmit.com

# For SendGrid:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# For AWS SES:
# MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=your-ses-smtp-username
# MAIL_PASSWORD=your-ses-smtp-password

# =============================================================================
# API CONFIGURATION
# =============================================================================
ENABLE_API=true
API_RATE_LIMIT=100 per hour  # Rate limit for API endpoints

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_WEBHOOKS=false  # Enable webhook system
ENABLE_TWO_FACTOR=false  # Enable 2FA authentication

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Sentry for error tracking (optional)
# SENTRY_DSN=https://key@sentry.io/project-id

# =============================================================================
# DATABASE OPTIONS
# =============================================================================
# Show SQL queries in console (development only)
SQL_ECHO=false

# =============================================================================
# PAYMENT GATEWAY (Future Integration)
# =============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MODE=sandbox  # Options: sandbox, live

# =============================================================================
# STORAGE (Future Integration)
# =============================================================================
# For file uploads (alternative to local storage)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=farmit-uploads
# AWS_REGION=us-east-1

# =============================================================================
# ANALYTICS (Future Integration)
# =============================================================================
# GOOGLE_ANALYTICS_ID=UA-...
# MIXPANEL_TOKEN=...

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env file to version control
# - Use strong, unique passwords for production
# - Rotate secrets regularly
# - Use environment-specific values
# - Keep development and production secrets separate
